#!/bin/sh
# Runs the gate before every push (ADR-0000); covers macOS arm64 between the weekly
# CI runs. Enable once per clone:
#   git config core.hooksPath .githooks
# The gate requires a clean working tree, so commit or stash first.
#
# The code is public and the planning private (ADR-0000 point 10): a push whose new
# commits touch docs/, HANDOFF.md or CLAUDE.md is refused, except to the private archive.
remote="$1"
url="$2"
case "$url" in
  *simagent-archive*) ;;
  *)
    while read -r local_ref local_sha remote_ref remote_sha; do
      case "$local_sha" in *[!0]*) ;; *) continue ;; esac
      planning=$(git log --format= --name-only "$local_sha" --not --remotes="$remote" |
        grep -E '^(docs/|HANDOFF\.md$|CLAUDE\.md$)' | sort -u)
      if [ -n "$planning" ]; then
        echo "refused: $local_ref would carry planning to $url:" >&2
        echo "$planning" | sed 's/^/  /' >&2
        exit 1
      fi
    done
    ;;
esac
exec cargo xtask ci
