# Auto detect text files and perform LF normalization
* text=auto

# Files whose bytes feed hashes, goldens or codegen always use LF (ADR-0000).
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
tests/golden/** text eol=lf
# Golden saves are binary: no line-ending conversion, or a 0d 0a pair in the bytes
# would be rewritten on commit (ADR-0006).
*.save binary
data/** text eol=lf
contracts/** text eol=lf
